[Unit]
Description=Claude History Server
After=network.target

[Service]
Type=simple
User=sungo
WorkingDirectory=/home/sungo/Documents/termux-app-dev
ExecStart=/usr/bin/python3 /home/sungo/Documents/termux-app-dev/tools/claude-history-server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
