<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connection Name"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/eveng1_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., My G1 Glasses"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Channel Number"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/eveng1_channel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., 1"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Left Device"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/eveng1_left_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Device name (e.g., G1_L_001)"
            android:inputType="text" />

        <EditText
            android:id="@+id/eveng1_left_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="MAC address (e.g., AA:BB:CC:DD:EE:FF)"
            android:inputType="text"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Right Device"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/eveng1_right_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Device name (e.g., G1_R_001)"
            android:inputType="text" />

        <EditText
            android:id="@+id/eveng1_right_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="MAC address (e.g., AA:BB:CC:DD:EE:FF)"
            android:inputType="text"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Note: You can scan for devices from the main G1 connection button."
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>

</ScrollView>
