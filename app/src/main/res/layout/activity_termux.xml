<com.termux.app.terminal.TermuxActivityRootView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_termux_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:id="@+id/activity_termux_root_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="3dp"
        android:layout_marginVertical="0dp"
        android:orientation="vertical">

        <androidx.drawerlayout.widget.DrawerLayout
            android:id="@+id/drawer_layout"
            android:layout_width="match_parent"
            android:layout_alignParentTop="true"
            android:layout_above="@+id/terminal_toolbar_view_pager"
            android:layout_height="match_parent">

            <com.termux.view.TerminalView
                android:id="@+id/terminal_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:defaultFocusHighlightEnabled="false"
                android:focusableInTouchMode="true"
                android:scrollbarThumbVertical="@drawable/terminal_scroll_shape"
                android:scrollbars="vertical"
                tools:ignore="UnusedAttribute" />

            <LinearLayout
                android:id="@+id/left_drawer"
                android:layout_width="240dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:choiceMode="singleChoice"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:descendantFocusability="blocksDescendants"
                android:orientation="vertical"
                android:background="?attr/termuxActivityDrawerBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageButton
                        android:id="@+id/settings_button"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_settings"
                        android:background="@null"
                        android:contentDescription="@string/action_open_settings"
                        app:tint="?attr/termuxActivityDrawerImageTint" />
                </LinearLayout>

                <ListView
                    android:id="@+id/terminal_sessions_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_gravity="top"
                    android:layout_weight="1"
                    android:choiceMode="singleChoice"
                    android:longClickable="true" />

                <LinearLayout
                    style="?android:attr/buttonBarStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/toggle_keyboard_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_toggle_soft_keyboard" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/new_session_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_new_session" />
                </LinearLayout>
            </LinearLayout>

        </androidx.drawerlayout.widget.DrawerLayout>

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/terminal_toolbar_view_pager"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="37.5dp"
            android:background="@color/black"
            android:layout_alignParentBottom="true" />

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/ar_sync_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AR Sync: Standby"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="#80000000"
            android:padding="4dp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/byobuSessionsButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="SESSIONS"
                android:textSize="12sp"
                android:backgroundTint="#2196F3"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginEnd="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/customCommandsButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="CUSTOM"
                android:textSize="12sp"
                android:backgroundTint="#FF5722"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginHorizontal="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/byobuCommandsButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="HELP"
                android:textSize="12sp"
                android:backgroundTint="#9C27B0"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="1dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/previousSessionButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="Prev"
                android:textSize="12sp"
                android:backgroundTint="#607D8B"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginEnd="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nextSessionButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="Next"
                android:textSize="12sp"
                android:backgroundTint="#607D8B"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginHorizontal="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sshConnectButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="SSH"
                android:textSize="12sp"
                android:backgroundTint="#4CAF50"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginHorizontal="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sshManageButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="設定"
                android:textSize="12sp"
                android:backgroundTint="#9E9E9E"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="1dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/evenG1ConnectButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="G1"
                android:textSize="12sp"
                android:backgroundTint="#E91E63"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginEnd="1dp" />

             <com.google.android.material.button.MaterialButton
                android:id="@+id/dirNavButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="DIR"
                android:textSize="12sp"
                android:backgroundTint="#FF9800"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginHorizontal="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/aiAssistantButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="AI"
                android:textSize="12sp"
                android:backgroundTint="#673AB7"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginHorizontal="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/claudeSyncButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="CLAUDE"
                android:textSize="12sp"
                android:backgroundTint="#2196F3"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="1dp" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/activity_termux_bottom_space_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/transparent" />

</com.termux.app.terminal.TermuxActivityRootView>
